# Contact form email. Copy to .env.local for local work; set the same values in
# Vercel (Project → Settings → Environment Variables) for production.
# Never commit real values: this repository is public.

# Password of the hello@calcifyint.com mailbox.
SMTP_PASS=

# Who is told about each enquiry, comma-separated.
ENQUIRY_NOTIFY_TO=

# Optional. These default to Spacemail and the hello@ mailbox.
# SMTP_HOST=mail.spacemail.com
# SMTP_PORT=465
# SMTP_USER=hello@calcifyint.com

# --- Analytics & search (all optional; each feature is off when unset) ---

# Google Analytics 4 measurement ID. Defaults to G-LKZBMLHQBM (src/lib/site.ts);
# set to override, or leave empty to disable. e.g. G-XXXXXXXXXX
# (Analytics → Admin → Data streams → Web).
# NEXT_PUBLIC_GA_ID=

# Google Search Console, "HTML tag" verification method: paste only the
# content="..." value. Then submit https://www.calcifyint.com/sitemap.xml.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools msvalidate.01 value (optional).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Canonical origin; defaults to https://www.calcifyint.com.
# NEXT_PUBLIC_SITE_URL=

# --- reCAPTCHA v3 (contact form) ---
# Site key is public; defaults to the "Calcify Int" key in src/lib/recaptcha.ts.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key: server only, never commit it. Verification is skipped when unset.
RECAPTCHA_SECRET_KEY=
# Optional score threshold, 0.0–1.0 (default 0.5).
# RECAPTCHA_MIN_SCORE=0.5
