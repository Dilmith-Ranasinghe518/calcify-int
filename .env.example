# Contact form email. Copy to .env.local for local work; set the same values in
# Vercel (Project → Settings → Environment Variables) for production.
# Never commit real values: this repository is public.

# Password of the hello@calcifyint.com mailbox.
SMTP_PASS=

# Who is told about each enquiry, comma-separated.
ENQUIRY_NOTIFY_TO=

# Optional. These default to Spacemail and the hello@ mailbox.
# SMTP_HOST=mail.spacemail.com
# SMTP_PORT=465
# SMTP_USER=hello@calcifyint.com
